# 컨테이너 이름을 고정한다. 이게 없으면 -p 를 빼먹은 순간 프로젝트 이름이
# 디렉토리명에서 유추되고, infra/README.md 의 헬스 판정
# (docker inspect gardevoir-postgres-1) 이 조용히 깨진다.
COMPOSE_PROJECT_NAME=gardevoir

# 서비스별 env 파일이 필요해지면 compose에서
#   env_file: ../envs/${GARDEVOIR_ENV_DIR}/<svc>.env
# 로 참조한다. 각 compose.env가 자기 디렉토리를 self-select 하므로 셸에 변수를
# 둘 필요가 없다. 현재 사용처 없음 — 전방 훅이다.
GARDEVOIR_ENV_DIR=example

# 21000 블록. 이 머신은 10000번대, 18090/50070,
# 20000-20070 이 이미 사용 중이므로 기본 포트를 쓰지 않는다.
GATEWAY_HTTP_PORT=21000
POSTGRES_PORT=21010
CLICKHOUSE_HTTP_PORT=21020
REDIS_PORT=21030
CONSOLE_HTTP_PORT=3000

# 로컬 런타임 가드레일. MEMSWAP_LIMIT을 MEM_LIMIT과 같게 두면 컨테이너가
# 예산을 넘어 스왑하지 못한다. 실측 여유: ClickHouse 426MiB/2g, Postgres 35MiB/512m.
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEMSWAP_LIMIT=512m
POSTGRES_CPUS=1.0
CLICKHOUSE_MEM_LIMIT=2g
CLICKHOUSE_MEMSWAP_LIMIT=2g
CLICKHOUSE_CPUS=2.0

REDIS_MEM_LIMIT=256m
REDIS_MEMSWAP_LIMIT=256m
REDIS_CPUS=1.0

# ── 애플리케이션(게이트웨이·콘솔) — 이 파일은 템플릿(localhost). 실제 값은
#    infra/envs/local/compose.env 에서 덮어쓴다(--env-file 을 뒤에 하나 더 준다).
# 브라우저가 직접 호출하는 게이트웨이 주소. next build 때 콘솔 번들로 고정된다.
NEXT_PUBLIC_API_BASE=http://localhost:21000/v1
# 게이트웨이가 CORS 로 허용할 오리진(콤마 구분). 콘솔을 여는 오리진과 일치해야 한다.
GARDEVOIR_CORS_ALLOW_ORIGINS=http://localhost:3000
# 개발용 기본값 — 운영/실사용에서는 local env 에서 교체.
GARDEVOIR_JWT_SECRET=dev-only-change-me-0123456789abcdef
GARDEVOIR_ROOT_EMAIL=root@ex.com
GARDEVOIR_ROOT_PASSWORD=rootpassword123

# Shieldstral은 별도 운영 트랙에서 서빙한다. 기본은 반드시 꺼져 있어 MODEL pending이
# 기존처럼 통과+감사되고, 켰을 때의 판정 실패만 fail mode를 탄다.
GARDEVOIR_MODEL_JUDGE__ENABLED=false
GARDEVOIR_MODEL_JUDGE__ENDPOINT=
GARDEVOIR_MODEL_JUDGE__MODEL=mistralai/Shieldstral-1.0-3B
GARDEVOIR_MODEL_JUDGE__REVISION=
GARDEVOIR_MODEL_JUDGE__THRESHOLD=0.5
GARDEVOIR_MODEL_JUDGE__TIMEOUT_MS=1000
GARDEVOIR_MODEL_JUDGE__FAIL_MODE__INPUT=closed
GARDEVOIR_MODEL_JUDGE__FAIL_MODE__TOOL_RESULT=closed
GARDEVOIR_MODEL_JUDGE__FAIL_MODE__OUTPUT=open
GARDEVOIR_MODEL_JUDGE__FAIL_MODE__TOOL_CALL=closed
